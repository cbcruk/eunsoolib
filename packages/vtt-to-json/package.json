{
  "name": "@cbcruk/vtt-to-json",
  "description": "WebVTT 자막을 중복 제거된 cue 배열로 파싱",
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/eunsoolib.git",
    "directory": "packages/vtt-to-json"
  },
  "homepage": "https://cbcruk.github.io/eunsoolib/docs/media/vtt-to-json/",
  "files": [
