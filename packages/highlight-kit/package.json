{
  "name": "@cbcruk/highlight-kit",
  "description": "CSS Custom Highlight API 기반 텍스트 하이라이트 core와 React 어댑터",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbcruk/eunsoolib.git",
    "directory": "packages/highlight-kit"
  },
  "homepage": "https://cbcruk.github.io/eunsoolib/docs/dom/highlight-kit/",
  "files": [
    "dist"
  ],
